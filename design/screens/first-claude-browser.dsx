<Screen id="first-claude-browser" title="Claude · Await first-provider authorization" layout="settings" background="color.canvas">
  <Text variant="heading" fontSize="font.size.lg">Waiting for Claude</Text>
  <Card variant="outlined" padding="spacing.lg" radius="radius.card" borderColor="color.border">
    <Stack gap="spacing.md">
      <Text color="color.subtle">Finish signing in on the provider’s page.</Text>
      <Disclosure id="claude-manual" label="Enter the callback URL or code" styleClass="provider-summary">
        <Stack gap="spacing.sm" padding="spacing.sm">
          <Input id="claude-callback" label="Callback URL or code" />
          <Stack align="start"><Button id="claude-submit" styleClass="provider-action">Submit</Button></Stack>
        </Stack>
      </Disclosure>
      <Stack align="end"><Button id="cancel-claude-login" variant="secondary" styleClass="provider-action" onPress={navigate("setup-first-claude")}>Cancel sign-in</Button></Stack>
    </Stack>
  </Card>
</Screen>
