<Screen
  id="subscriptions"
  title="Subscriptions · Configured providers"
  background="color.canvas"
  layout="settings"
  states={{
    "quota-preferences": { disclosures: { "quota-display-settings": true } },
    "codex-expanded": { disclosures: { codex: true } },
    "manage-codex": { open: ["codex-manager"], disclosures: { codex: true } },
    "pool-models-open": { open: ["codex-manager"], disclosures: { codex: true, "codex-pool-models": true } },
    "codex-credits-open": { disclosures: { codex: true, "codex-credits": true } },
    "confirm-codex-reset": { open: ["codex-reset"], disclosures: { codex: true, "codex-credits": true } }
  }}
>
  <Box id="quota-preferences" padding="spacing.sm" radius="radius.md" background="color.selected">
    <Disclosure id="quota-display-settings" label="Quota display preferences" styleClass="quota-trigger">
      <Stack gap="spacing.tight" padding="spacing.sm">
        <Select id="status-bar-quota" styleClass="field" label="Status-bar quota display" value="recent" options={[
          { label: "Current / most recent provider with usage", value: "recent" },
          { label: "Always show one provider, rotating through the rest", value: "always" },
          { label: "Hidden", value: "hidden" }
        ]} />
        <Text color="color.subtle" variant="caption" styleClass="copy-note">Saved automatically in this browser. One provider is shown at a time. Models without a quota source keep the most recent provider selected in this view, or show nothing. Always show instead rotates through the providers with usage every 10 seconds while the current model has no quota source. Hiding does not affect usage details here.</Text>
        <Select id="quota-percentages" styleClass="field" label="Quota percentages" value="used" options={[
          { label: "Used (default)", value: "used" }, { label: "Remaining", value: "remaining" }
        ]} />
        <Text color="color.subtle" variant="caption" styleClass="copy-note">Applies to Settings and the status bar, independently of hiding. Warning colors always indicate high usage.</Text>
        <Select id="usage-coloring" styleClass="field" label="Usage coloring" value="standard" options={[
          { label: "Standard (default · 10-point lead)", value: "standard" },
          { label: "Relaxed (15-point lead)", value: "relaxed" },
          { label: "Remaining quota only (no yellow)", value: "remaining" }
        ]} />
        <Text color="color.subtle" variant="caption" styleClass="copy-note">Yellow when usage leads elapsed time by 10 points; red at 90% used takes priority. Saved in this browser; only colors change.</Text>
      </Stack>
    </Disclosure>
  </Box>
  <Variants id="provider-list" chosen="configured">
    <Variant branch="configured">
      <Stack id="subscriptions-heading" styleClass="roster-heading" direction="row" align="center" justify="between" gap="spacing.sm" wrap>
        <Text variant="heading" fontSize="font.size.lg" fontWeight="font.weight.medium">Configured providers</Text>
        <Button id="add-provider" styleClass="provider-action" onPress={navigate("add-provider")}>+ Add provider</Button>
      </Stack>
      <Card id="configured-providers" variant="outlined" padding="spacing.xs" radius="radius.account" borderColor="color.border">
        <Stack>
          <Disclosure id="codex" label="Codex (ChatGPT) · 1 account connected" styleClass="provider-summary">
            <Stack id="codex-detail" gap="spacing.sm" padding="spacing.md">
              <Text color="color.subtle" variant="caption">CLI 9.9.9 · latest on npm</Text>
              <Card id="codex-account" variant="outlined" padding="spacing.sm" radius="radius.account" borderColor="color.stroke">
                <Stack gap="spacing.sm">
                  <Stack direction="row" justify="between" align="center" gap="spacing.sm" wrap>
                    <Stack gap="spacing.xs">
                      <Stack direction="row" align="center" gap="spacing.sm">
                        <Text color="color.warning">★</Text>
                        <Text fontSize="font.size.field">codex-demo</Text>
                      </Stack>
                      <Text color="color.subtle" variant="caption">Expires Jan 1, 2100, 12:00 AM</Text>
                    </Stack>
                  <Button id="codex-log-out" styleClass="provider-action" variant="secondary" size="sm">Log out</Button>
                  </Stack>
                  <Divider />
                  <Stack direction="row" align="center" justify="between" gap="spacing.sm">
                    <Stack direction="row" align="center" gap="spacing.sm">
                      <Text color="color.subtle" variant="caption" fontWeight="font.weight.medium">Usage</Text>
                      <Text color="color.subtle" variant="caption">Plan: plus</Text>
                    </Stack>
                    <Button id="codex-refresh" styleClass="provider-action" variant="secondary" size="sm">Refresh</Button>
                  </Stack>
                  <Stack gap="spacing.xs">
                    <Stack direction="row" justify="between" gap="spacing.xs" wrap>
                      <Text color="color.subtle" variant="caption">5-hour window</Text>
                      <Text color="color.subtle" variant="caption">11% used · 22% elapsed · resets 12/1/2026, 2:00 PM</Text>
                    </Stack>
                    <Tooltip text="11% used · 22% of the window elapsed">
                      <Stack id="codex-five-hour-meter" direction="row" styleClass="quota-meter" radius="radius.sm">
                        <Box width="size.session-fill" height="spacing.meter-fill" background="color.connected" />
                        <Box width="size.session-fill" height="spacing.meter-fill" />
                        <Box width="spacing.marker" height="spacing.meter-fill" background="color.text" />
                      </Stack>
                    </Tooltip>
                  </Stack>
                  <Stack gap="spacing.xs">
                    <Stack direction="row" justify="between" gap="spacing.xs" wrap>
                      <Text color="color.subtle" variant="caption">Weekly</Text>
                      <Text color="color.subtle" variant="caption">86% used · 72% elapsed · resets 12/4/2026, 2:00 PM</Text>
                    </Stack>
                    <Tooltip text="86% used · 72% of the window elapsed">
                      <Stack id="codex-weekly-meter" direction="row" styleClass="quota-meter" radius="radius.sm">
                        <Box width="size.weekly-elapsed" height="spacing.meter-fill" background="color.warning" />
                        <Box width="spacing.marker" height="spacing.meter-fill" background="color.text" />
                        <Box width="size.weekly-after-marker" height="spacing.meter-fill" background="color.warning" />
                      </Stack>
                    </Tooltip>
                  </Stack>
                  <Disclosure id="codex-credits" label="Usage limit resets · 1 available" styleClass="provider-summary">
                    <Stack id="codex-credit-details" direction="row" align="center" justify="between" gap="spacing.sm" wrap>
                      <Stack direction="row" align="center" gap="spacing.sm">
                        <Text color="color.subtle" variant="caption">Full reset</Text>
                        <Button id="codex-use-credit" styleClass="provider-action" size="sm" variant="secondary" onPress={open("codex-reset")}>Use…</Button>
                      </Stack>
                      <Text color="color.subtle" variant="caption">Expires 12/31/2026, 11:59 PM</Text>
                    </Stack>
                  </Disclosure>
                </Stack>
              </Card>
              <Stack direction="row" align="center" gap="spacing.sm" wrap>
                <Button id="codex-add" styleClass="provider-action" size="sm" variant="secondary">Add account</Button>
                <Button id="codex-manage" styleClass="provider-action" size="sm" variant="secondary" onPress={open("codex-manager")}>Manage</Button>
              </Stack>
              <Text color="color.subtle" variant="caption" styleClass="copy-note">Switch accounts in your browser before authorizing another Codex account.</Text>
            </Stack>
          </Disclosure>
        </Stack>
        <Divider />
        <Stack>
          <Disclosure id="kimi-code" label="Kimi Code · API key configured" styleClass="provider-summary">
            <Stack id="kimi-detail" gap="spacing.sm" padding="spacing.md">
              <Text color="color.subtle" variant="caption">This key is managed in Settings → Models.</Text>
              <Divider />
              <Stack direction="row" align="center" justify="between" gap="spacing.sm" wrap>
                <Text variant="label">Usage</Text>
                <Button id="kimi-refresh" styleClass="provider-action" variant="secondary" size="sm">Refresh</Button>
              </Stack>
              <Text color="color.subtle" variant="caption">Weekly · 24% used</Text>
              <Progress id="kimi-weekly" value={24} label="Weekly usage" tone="success" />
            </Stack>
          </Disclosure>
        </Stack>
      </Card>
    </Variant>
    <Variant branch="empty">
      <Stack id="subscriptions-heading" styleClass="roster-heading" direction="row" align="center" justify="between" gap="spacing.sm" wrap>
        <Text variant="heading" fontSize="font.size.lg" fontWeight="font.weight.medium">Configured providers</Text>
        <Button id="add-provider" styleClass="provider-action" onPress={navigate("add-first-provider")}>+ Add provider</Button>
      </Stack>
      <Card variant="outlined" padding="spacing.lg" radius="radius.card" borderColor="color.border">
        <Stack id="empty-providers" gap="spacing.xs">
          <Text variant="label">No providers configured</Text>
          <Text color="color.subtle">Use Add provider to connect your first provider.</Text>
        </Stack>
      </Card>
    </Variant>
    <Variant branch="loading">
      <Stack id="subscriptions-heading" styleClass="roster-heading" direction="row" align="center" justify="between" gap="spacing.sm" wrap>
        <Text variant="heading" fontSize="font.size.lg" fontWeight="font.weight.medium">Configured providers</Text>
        <Button id="add-provider" styleClass="provider-action" disabled>+ Add provider</Button>
      </Stack>
      <Card variant="outlined" padding="spacing.lg" radius="radius.card" borderColor="color.border">
        <Text id="loading-providers" color="color.subtle">Checking which providers are configured…</Text>
      </Card>
    </Variant>
    <Variant branch="status-error">
      <Stack id="subscriptions-heading" styleClass="roster-heading" direction="row" align="center" justify="between" gap="spacing.sm" wrap>
        <Text variant="heading" fontSize="font.size.lg" fontWeight="font.weight.medium">Configured providers</Text>
        <Button id="add-provider" styleClass="provider-action" disabled>+ Add provider</Button>
      </Stack>
      <Card variant="outlined" padding="spacing.lg" radius="radius.card" borderColor="color.border">
        <Stack gap="spacing.sm" align="start">
          <Text variant="label">Could not load providers</Text>
          <Text color="color.subtle">Retry to see which providers are configured.</Text>
          <Button id="retry-providers" variant="secondary" styleClass="provider-action">Retry</Button>
        </Stack>
      </Card>
    </Variant>
  </Variants>
  <Modal id="codex-manager" title="Manage Codex (ChatGPT) accounts" size="lg" styleClass="account-dialog">
    <Stack gap="spacing.md">
      <Text color="color.subtle" variant="caption" styleClass="copy-note">Choose which accounts serve pooled LLM requests. Pool exclusion applies only to LLM routing, not tools or session-wide isolation.</Text>
      <Card id="codex-routing" variant="outlined" padding="spacing.inset" radius="radius.account" borderColor="color.stroke">
        <Stack gap="spacing.sm">
          <Text variant="heading" fontSize="font.size.md" fontWeight="font.weight.medium">codex-demo</Text>
          <Input id="codex-alias" label="Alias (optional)" placeholder="codex-demo" />
          <Checkbox id="codex-in-pool" label="Include in the LLM account pool" checked />
          <Checkbox id="codex-independent" label="Show an independent entry in the model picker" />
          <Text color="color.subtle" variant="caption" styleClass="copy-note">Independent LLM routes use only this account, with no fallback to another account. This does not isolate tools or the whole session.</Text>
          <Disclosure id="codex-pool-models" label="Pool model allowlist · All models">
            <Stack id="codex-pool-options" gap="spacing.sm" padding="spacing.sm">
              <Text color="color.subtle" variant="caption" styleClass="copy-note">Applies only to pooled LLM routing, not independent entries. An empty selection allows no models. Turning off pool participation keeps this selection for later.</Text>
              <Checkbox id="codex-pool-auto" label="Allow all models, including future models" checked />
              <Stack direction="row" gap="spacing.sm" wrap>
                <Button id="codex-pool-select-all" size="sm" variant="secondary">Select all</Button>
                <Button id="codex-pool-clear" size="sm" variant="secondary">Clear selection</Button>
              </Stack>
              <Checkbox id="codex-pool-example" label="Example Codex model" checked />
            </Stack>
          </Disclosure>
        </Stack>
      </Card>
      <Divider />
      <Text variant="heading" fontSize="font.size.md" fontWeight="font.weight.medium">Edit model list</Text>
      <Text color="color.subtle" variant="caption" styleClass="copy-note">Configure model visibility, default reasoning effort, subagent speed, context and tools here; Save changes below submits them together with the account settings. Hidden models remain usable by existing sessions; tool changes apply to new sessions.</Text>
      <Stack align="start">
        <Button id="codex-model-refresh" variant="ghost" size="sm">Refresh</Button>
      </Stack>
      <Checkbox id="codex-visible-auto" label="Automatically show all models, including new models" checked />
      <Stack direction="row" align="center" gap="spacing.sm" wrap>
        <Input id="codex-model-filter" label="Filter models" placeholder="Filter models" type="search" grow />
        <Button id="codex-model-select-all" variant="secondary" size="sm">Select all</Button>
        <Button id="codex-model-clear" variant="secondary" size="sm">Clear selection</Button>
      </Stack>
      <Checkbox id="codex-model-example" label="Example Codex model" checked />
      <Stack direction={{ mobile: "column", tablet: "row" }} gap="spacing.sm" wrap>
        <Select id="codex-reasoning" label="Default reasoning effort" value="provider" options={[
          { label: "Follow provider", value: "provider" }, { label: "Low", value: "low" }, { label: "Medium", value: "medium" }, { label: "High", value: "high" }
        ]} />
        <Input id="codex-context" label="Context (tokens)" type="number" />
        <Select id="codex-subagent-speed" label="Subagent default speed" value="provider" options={[
          { label: "Follow provider", value: "provider" }, { label: "Standard", value: "standard" }, { label: "Fast", value: "fast" }
        ]} />
      </Stack>
      <Divider />
      <Text variant="heading" fontSize="font.size.md" fontWeight="font.weight.medium">Provider tools</Text>
      <Text color="color.subtle" variant="caption" styleClass="copy-note">Changes apply only to sessions created after saving. Existing sessions keep their tools. Shared tools remain available if any supporting provider is enabled.</Text>
      <Checkbox id="codex-image-tool" label="Image generation" checked />
      <Stack id="codex-manager-actions" direction="row" justify="end" gap="spacing.sm" wrap>
        <Button id="codex-manager-cancel" styleClass="provider-action" variant="secondary" onPress={close("codex-manager")}>Cancel</Button>
        <Button id="codex-save" disabled>Save changes</Button>
      </Stack>
    </Stack>
  </Modal>
  <Modal id="codex-reset" title="Confirm full reset" styleClass="reset-dialog">
    <Stack gap="spacing.md">
      <Text color="color.subtle" variant="caption">codex-demo</Text>
      <Stack direction="row" justify="between" gap="spacing.sm">
        <Text color="color.subtle" variant="caption">Weekly</Text>
        <Text variant="label">86%</Text>
      </Stack>
      <Text color="color.subtle" variant="caption">Expires 12/31/2026, 11:59 PM</Text>
      <Text color="color.subtle" variant="caption" styleClass="copy-note">This consumes one credit and resets weekly + 5-hour limits. This interface cannot undo it. Confirmation expires in 60 seconds.</Text>
      <Checkbox id="codex-reset-ack" label="I understand that one credit will be consumed." />
      <Stack direction="row" justify="end" gap="spacing.sm" wrap>
        <Button id="codex-reset-cancel" styleClass="provider-action" variant="secondary" onPress={close("codex-reset")}>Cancel</Button>
        <Button id="codex-reset-consume" styleClass="provider-action" disabled>Consume 1 reset</Button>
      </Stack>
    </Stack>
  </Modal>
</Screen>
