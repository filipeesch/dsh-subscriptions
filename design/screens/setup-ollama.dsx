<Screen id="setup-ollama" title="2. Configure Ollama" layout="settings" background="color.canvas" states={{ local: { tabs: { "ollama-connection-type": "local" } }, "picker-open": { open: ["provider-options"] } }}>
  <Text id="add-provider-heading" variant="heading" fontSize="font.size.lg" fontWeight="font.weight.medium">Add provider</Text>
  <Card id="add-provider-form" variant="outlined" padding="spacing.lg" radius="radius.card" borderColor="color.border">
    <Stack gap="spacing.lg">
      <Stack gap="spacing.xs">
        <Text variant="label" id="provider-label">Provider</Text>
        <Button id="provider-select" variant="secondary" styleClass="provider-select" fullWidth onPress={open("provider-options")}>
          <Text align="left" styleClass="provider-option-label">Ollama</Text>
          <Icon name="chevron-down" size="spacing.icon" />
        </Button>
      </Stack>
      <Divider />
      <Stack id="provider-configuration" gap="spacing.md">
        <Tabs id="ollama-connection-type" label="Connection type" value="cloud">
          <Tab styleClass="provider-tab" id="ollama-cloud-tab" label="Cloud" value="cloud">
            <Stack gap="spacing.md">
              <Input id="ollama-key" label="Ollama Cloud API key" type="password" />
              <Text color="color.subtle" variant="caption">Preview only. No key is saved here.</Text>
              <Stack direction="row" justify="end" gap="spacing.sm" wrap>
                <Button id="cancel-ollama-cloud" variant="secondary" styleClass="provider-action" onPress={navigate("subscriptions")}>Cancel</Button>
                <Button id="save-ollama-key" styleClass="provider-action" disabled>Save</Button>
              </Stack>
            </Stack>
          </Tab>
          <Tab styleClass="provider-tab" id="ollama-local-tab" label="Local server" value="local">
            <Stack gap="spacing.md">
              <Input id="ollama-local-url" label="Base URL" value="http://localhost:11434" />
              <Text color="color.subtle">Use a server you trust. Saving the address does not check whether the server is reachable.</Text>
              <Stack direction="row" justify="end" gap="spacing.sm" wrap>
                <Button id="cancel-ollama-local" variant="secondary" styleClass="provider-action" onPress={navigate("subscriptions")}>Cancel</Button>
                <Button id="save-ollama-local" styleClass="provider-action" onPress={navigate("subscriptions-with-ollama")}>Save</Button>
              </Stack>
            </Stack>
          </Tab>
        </Tabs>
      </Stack>
    </Stack>
  </Card>
  <Popover id="provider-options" anchor="provider-select" title="Choose a provider · 11 options" padding="spacing.sm" styleClass="provider-menu">
    <Stack gap="spacing.xs">
      <Text color="color.subtle" variant="caption" styleClass="provider-menu-note">Scroll to see all providers.</Text>
      <Button id="choose-ollama" variant="ghost" styleClass="provider-option" fullWidth onPress={close("provider-options")}><Text align="left" styleClass="provider-option-label">Ollama · Selected</Text></Button>
      <Button id="choose-claude" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-claude")}><Text align="left" styleClass="provider-option-label">Claude</Text></Button>
      <Button id="choose-codex" variant="ghost" styleClass="provider-option" fullWidth disabled><Text align="left" styleClass="provider-option-label">Codex (ChatGPT) · Configured</Text></Button>
      <Button id="choose-cursor" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-cursor")}><Text align="left" styleClass="provider-option-label">Cursor</Text></Button>
      <Button id="choose-copilot" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-copilot")}><Text align="left" styleClass="provider-option-label">GitHub Copilot</Text></Button>
      <Button id="choose-antigravity" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-antigravity")}><Text align="left" styleClass="provider-option-label">Google Antigravity</Text></Button>
      <Button id="choose-grok" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-grok")}><Text align="left" styleClass="provider-option-label">Grok (X Premium)</Text></Button>
      <Button id="choose-kimi-code" variant="ghost" styleClass="provider-option" fullWidth disabled><Text align="left" styleClass="provider-option-label">Kimi Code · Configured</Text></Button>
      <Button id="choose-minimax" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-minimax")}><Text align="left" styleClass="provider-option-label">MiniMax</Text></Button>
      <Button id="choose-minimax-cn" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-minimax-cn")}><Text align="left" styleClass="provider-option-label">MiniMax CN</Text></Button>
      <Button id="choose-opencode-go" variant="ghost" styleClass="provider-option" fullWidth onPress={navigate("setup-opencode-go")}><Text align="left" styleClass="provider-option-label">OpenCode Go</Text></Button>
    </Stack>
  </Popover>
</Screen>
